   },
   {
    "qty": 1,
    "unit": "",
    "name": "petit morceau de gingembre râpé"
   },
   {
    "qty": 2,
    "unit": "c. à s.",
    "name": "huile végétale"
   },
   {
    "qty": 0.5,
    "unit": "c. à c.",
    "name": "curcuma moulu"
   },
   {
    "qty": 0.5,
    "unit": "c. à c.",
    "name": "graines de cumin entières"
